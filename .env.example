# Database used by the API. Use a strong password in preproduction.
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://assistent:change-me@postgres:5432/assistent_esportiu

# Private values: never expose them in the mobile/PWA client.
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
WEB_ORIGIN=http://localhost:5173

# Initial coordinators, comma-separated. They can bootstrap the club context.
BOOTSTRAP_COORDINATOR_EMAILS=

# Fixed, club-wide temporary password (JME-56). A coordinator resets a user
# onto this value via POST /v1/users/:id/reset-password; the user is forced
# to set their own password on first login. Leave unset to disable the reset
# endpoint (it replies 501).
TEMP_LOGIN_PASSWORD=

# Google service account dedicated to the Drive ingestion pipeline (JME-35)
# and the team-events Calendar sync (JME-30) — never the coordinator's
# personal account. Share it with both the Drive folder and the club's
# Calendar. Leave GOOGLE_SERVICE_ACCOUNT_* unset to disable both; leave
# DRIVE_FOLDER_ID/GOOGLE_CALENDAR_ID unset to disable just one. Private key
# stored with literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# Resend, for the training-preparation summary email (JME-44). Leave unset
# to disable sending — the preparation flow still works up to the PDF
# preview, "send" just returns 503.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
